<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
        xmlns:vm="using:ProvodkaNG.Desktop.ViewModels"
        x:Class="ProvodkaNG.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ПРОВОДКА NG — Телесистема MWD/LWD (УСО32 Авто • Dock)"
        Width="1500"
        Height="920"
        MinWidth="1120"
        MinHeight="740"
        Background="{DynamicResource BgCanvasBrush}">

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- ==================== MAIN MENU ==================== -->
    <Border Grid.Row="0"
            Background="{DynamicResource BgPanelBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,0,0,1">
      <Menu>
        <MenuItem Header="_Файл">
          <MenuItem Header="Открыть запись сигнала (.smp)..." Command="{Binding OpenSmpFileCommand}" />
          <MenuItem Header="Закрыть .smp и вернуться к УСО32"
                    Command="{Binding CloseSmpAndReturnToUsoCommand}"
                    IsEnabled="{Binding IsSmpPlayerActive}" />
          <Separator />
          <MenuItem Header="Загрузить КИХ-фильтр (KIH*.dat)..." Command="{Binding LoadFirFileCommand}" />
          <Separator />
          <MenuItem Header="Выход" Command="{Binding ExitApplicationCommand}" />
        </MenuItem>

        <MenuItem Header="_УСО32">
          <MenuItem Header="Переинициализировать и найти УСО32" Command="{Binding ForceReinitUsoCommand}" />
          <Separator />
          <MenuItem Header="Усиление (0x90..0x95)">
            <MenuItem Header="Ступень 0 (0x90)" Command="{Binding SetGainCommand}" CommandParameter="0" />
            <MenuItem Header="Ступень 1 (0x91)" Command="{Binding SetGainCommand}" CommandParameter="1" />
            <MenuItem Header="Ступень 2 (0x92)" Command="{Binding SetGainCommand}" CommandParameter="2" />
            <MenuItem Header="Ступень 3 (0x93)" Command="{Binding SetGainCommand}" CommandParameter="3" />
            <MenuItem Header="Ступень 4 (0x94)" Command="{Binding SetGainCommand}" CommandParameter="4" />
            <MenuItem Header="Ступень 5 (0x95)" Command="{Binding SetGainCommand}" CommandParameter="5" />
          </MenuItem>
          <MenuItem Header="Частота несущей">
            <MenuItem Header="16 Гц" Command="{Binding SetCarrierFreqCommand}" CommandParameter="16" />
            <MenuItem Header="10 Гц" Command="{Binding SetCarrierFreqCommand}" CommandParameter="10" />
            <MenuItem Header="7 Гц" Command="{Binding SetCarrierFreqCommand}" CommandParameter="7" />
            <MenuItem Header="5 Гц" Command="{Binding SetCarrierFreqCommand}" CommandParameter="5" />
            <MenuItem Header="3.6 Гц" Command="{Binding SetCarrierFreqCommand}" CommandParameter="3.6" />
            <MenuItem Header="2.5 Гц" Command="{Binding SetCarrierFreqCommand}" CommandParameter="2.5" />
            <MenuItem Header="1.8 Гц" Command="{Binding SetCarrierFreqCommand}" CommandParameter="1.8" />
          </MenuItem>
          <MenuItem Header="Кодировка (Ncod)">
            <MenuItem Header="Кодировка №1 (Ncod = 0)" Command="{Binding SetCodebookCommand}" CommandParameter="0" />
            <MenuItem Header="Кодировка №2 (Ncod = 1)" Command="{Binding SetCodebookCommand}" CommandParameter="1" />
          </MenuItem>
        </MenuItem>

        <MenuItem Header="_Окна">
          <MenuItem Header="Осциллограф" Command="{Binding ActivatePanelCommand}" CommandParameter="OscilloscopeDoc" />
          <MenuItem Header="Спектр (БПФ)" Command="{Binding ActivatePanelCommand}" CommandParameter="SpectrumDoc" />
          <MenuItem Header="Корреляция RM(1,4)" Command="{Binding ActivatePanelCommand}" CommandParameter="CorrelationDoc" />
          <MenuItem Header="Отклонитель (OTK)" Command="{Binding ActivatePanelCommand}" CommandParameter="ToolfaceTool" />
          <MenuItem Header="УСО32 и ЦОС" Command="{Binding ActivatePanelCommand}" CommandParameter="UsoControlTool" />
          <MenuItem Header="Инклинометрия и НДМ" Command="{Binding ActivatePanelCommand}" CommandParameter="InclinometryTool" />
          <MenuItem Header="Векторы RM(1,4)" Command="{Binding ActivatePanelCommand}" CommandParameter="VectorsTool" />
          <Separator />
          <MenuItem Header="Сбросить раскладку окон" Command="{Binding ResetDockLayoutCommand}" />
        </MenuItem>

        <MenuItem Header="_Вид">
          <MenuItem Header="Переключить тему (Ночная / Дневная вахта)" Command="{Binding ToggleShiftThemeCommand}" />
        </MenuItem>
      </Menu>
    </Border>

    <!-- ==================== COMPACT LIVE TELEMETRY HEADER (NO MANUAL START BUTTON) ==================== -->
    <Border Grid.Row="1"
            Background="{DynamicResource BgPanelBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,0,0,1"
            Padding="10,6">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="ПРОВОДКА NG"
                     FontSize="15"
                     FontWeight="Black"
                     Foreground="{DynamicResource AccentAmberBrush}"
                     VerticalAlignment="Center" />
          <Border Background="{DynamicResource BgCardBrush}"
                  BorderBrush="{DynamicResource BorderSubtleBrush}"
                  BorderThickness="1"
                  CornerRadius="3"
                  Padding="8,2"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding ModeBadge}"
                       FontSize="11"
                       FontWeight="Bold"
                       FontFamily="Consolas, monospace"
                       Foreground="{DynamicResource AccentCyanBrush}" />
          </Border>
          <TextBlock Text="{Binding DetectedUsoLabel}"
                     FontSize="12"
                     FontFamily="Consolas, monospace"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsSmpPlayerActive}">
          <TextBlock Text="{Binding ActiveSmpFileName, StringFormat='Плеер .smp: {0}'}"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource AccentAmberBrush}"
                     VerticalAlignment="Center" />
          <Button Content="Вернуться к УСО32"
                  Command="{Binding CloseSmpAndReturnToUsoCommand}"
                  Padding="10,3" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{Binding SimdIsa, StringFormat='SIMD: {0}'}"
                     FontSize="11"
                     FontFamily="Consolas, monospace"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     VerticalAlignment="Center" />
          <Button Content="{Binding ThemeButtonText}"
                  Command="{Binding ToggleShiftThemeCommand}"
                  Padding="10,4" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ==================== AVALONIA DOCK MANAGER WORKSPACE ==================== -->
    <dock:DockControl Grid.Row="2"
                      Layout="{Binding Layout}"
                      Margin="4" />

    <!-- ==================== BOTTOM STATUS BAR ==================== -->
    <Border Grid.Row="3"
            Background="{DynamicResource BgPanelBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,1,0,0"
            Padding="10,5">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0"
                   Text="{Binding StatusBanner}"
                   FontSize="11.5"
                   FontFamily="Consolas, monospace"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Grid.Column="1"
                   Text="{Binding TotalSamplesReceived, StringFormat='Отсчётов: {0}  •  УСО32 Авто + Dock Manager'}"
                   FontSize="11"
                   FontFamily="Consolas, monospace"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </Grid>
    </Border>
  </Grid>
</Window>
