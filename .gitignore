# Track only Stage 1 (dsp_core/) and Stage 2 (ProvodkaNG/) files when syncing to GitHub
*
!/.gitignore
!/dsp_core/
!/dsp_core/.gitignore
!/dsp_core/CMakeLists.txt
!/dsp_core/Makefile
!/dsp_core/README.md
!/dsp_core/include/
!/dsp_core/include/**
!/dsp_core/src/
!/dsp_core/src/**
!/dsp_core/tests/
!/dsp_core/tests/**

!/ProvodkaNG/
!/ProvodkaNG/**

# Exclude C++ build artifacts and compiled binaries
dsp_core/build/
dsp_core/**/*.o
dsp_core/**/*.obj
dsp_core/**/*.so
dsp_core/**/*.dll
dsp_core/**/*.dylib
dsp_core/**/*.a
dsp_core/**/*.lib
dsp_core/**/*.exe
dsp_core/**/test_dsp_core

# Exclude .NET build artifacts and IDE caches
ProvodkaNG/**/bin/
ProvodkaNG/**/obj/
ProvodkaNG/.vs/
ProvodkaNG/**/*.user

