# Track only dsp_core/, ProvodkaNG/, data/, and uso_emb/ when syncing to GitHub.
# NOTE: Avoid global '*' / '/*' or unspecific '/src/', '/dist/', '/*.cpp', '/*.h'
# because some GitHub sync .gitignore matchers strip leading '/' and ignore nested paths.

