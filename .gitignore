# Exclude C++ build artifacts and compiled binaries
dsp_core/build/
dsp_core/**/*.o
dsp_core/**/*.obj
dsp_core/**/*.so
dsp_core/**/*.dll
dsp_core/**/*.dylib
dsp_core/**/*.a
dsp_core/**/*.lib
dsp_core/**/*.exe
dsp_core/**/test_dsp_core

# Exclude .NET build artifacts and IDE caches
ProvodkaNG/**/bin/
ProvodkaNG/**/obj/
ProvodkaNG/.vs/
ProvodkaNG/**/*.user

# Exclude PlatformIO build cache and Python bytecode (keep uso_emb/dist/ binaries)
.pio/
uso_emb/.pio/
uso_emb/dist/
uso_emb/**/__pycache__/
uso_emb/.vs/
uso_emb/build/
